### 5.4 Implémentation backend (Django Channels)

**Configuration requise :**

```python
# settings.py
INSTALLED_APPS = [
    'daphne',  # ASGI server
    'channels',
    # ...
]

ASGI_APPLICATION = 'project.asgi.application'

CHANNEL_LAYERS = {
    'default': {
        'BACKEND': 'channels_redis.core.RedisChannelLayer',
        'CONFIG': {
            'hosts': [('127.0.0.1', 6379)],
        },
    },
}
```

**Consumer WebSocket :**

```python
# consumers.py
import json
from channels.generic.websocket import AsyncWebsocketConsumer
from channels.db import database_sync_to_async

class NotificationsConsumer(AsyncWebsocketConsumer):
    async def connect(self):
        # Récupérer token et org_id depuis query params
        token = self.scope['query_string'].decode().split('token=')[1].split('&')[0]
        org_id = self.scope['query_string'].decode().split('org_id=')[1]
        
        # Valider le token JWT
        user = await self.get_user_from_token(token)
        if not user:
            await self.close()
            return
        
        # Rejoindre le groupe de l'organisation
        self.org_group_name = f'notifications_{org_id}'
        await self.channel_layer.group_add(
            self.org_group_name,
            self.channel_name
        )
        
        await self.accept()
    
    async def disconnect(self, close_code):
        await self.channel_layer.group_discard(
            self.org_group_name,
            self.channel_name
        )
    
    async def notification_message(self, event):
        # Envoyer la notification au client
        await self.send(text_data=json.dumps(event['notification']))
    
    @database_sync_to_async
    def get_user_from_token(self, token):
        # Valider le JWT et retourner l'utilisateur
        # Utiliser la même logique que l'auth REST
        pass
```

**Broadcast d'une notification :**

```python
# utils/notifications.py
from channels.layers import get_channel_layer
from asgiref.sync import async_to_sync

def broadcast_notification(org_id, notification_type, title, message, payload):
    channel_layer = get_channel_layer()
    notification = {
        'id': str(uuid.uuid4()),
        'type': notification_type,
        'title': title,
        'message': message,
        'payload': payload,
        'created_at': timezone.now().isoformat(),
        'read': False
    }
    
    async_to_sync(channel_layer.group_send)(
        f'notifications_{org_id}',
        {
            'type': 'notification_message',
            'notification': notification
        }
    )
```

**Exemple d'utilisation :**

```python
# Dans la vue de création de vente POS
from utils.notifications import broadcast_notification

def create_sale(request):
