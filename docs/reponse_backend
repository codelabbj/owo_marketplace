        title='Nouvelle vente',
        message=f'Vente {sale.number} : {sale.total} FCFA',
        payload={
            'sale_id': str(sale.id),
            'sale_number': sale.number,
            'total': str(sale.total),
            'warehouse': sale.warehouse.name
        }
    )
    
    return Response(...)
